# 大模型配置。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=8

# 手机快捷指令仅使用 APP_API_TOKEN；后台管理仅使用 ADMIN_PASSWORD。
# 后台密码默认 12356；手机 Token 保持原配置。
APP_API_TOKEN=replace-with-a-long-random-token
ADMIN_PASSWORD=12356
DEFAULT_TIMEZONE=Asia/Taipei
DATABASE_URL=sqlite:///./data/bookkeeping.db

# Docker 部署配置。本机直接运行 Python 时不会使用。
DOMAIN=bookkeeping.example.com
DATA_HOST_DIR=./data
BACKUP_HOST_DIR=/var/backups/bookkeeping
